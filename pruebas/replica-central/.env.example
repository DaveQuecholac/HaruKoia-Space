# Copia a .env para R1+. Este archivo es plantilla; .env no se comitea.
# Credenciales solo de desarrollo local (PdC). No son secretos de producción.

# Postgres de la PdC (puerto distinto al de Space 54329)
POSTGRES_USER=harukoia
POSTGRES_PASSWORD=harukoia
POSTGRES_DB=harukoia
POSTGRES_PORT=54339
DATABASE_URL=postgresql://harukoia:harukoia@127.0.0.1:54339/harukoia

# PowerSync Service expuesto en el host (Space usa 18080)
POWERSYNC_PORT=18090
POWERSYNC_PUBLIC_URL=http://127.0.0.1:18090

# Buckets en el mismo Postgres (D-R4)
POWERSYNC_STORAGE_DB=powersync_storage
POWERSYNC_STORAGE_USER=powersync_storage
POWERSYNC_STORAGE_PASSWORD=powersync

# Rol de replicación lógica
POWERSYNC_ROLE=powersync_role
POWERSYNC_ROLE_PASSWORD=powersync

# Token de host de la sala de prueba (escritura). Solo PdC.
SALA_PRUEBA=pdc0000000000001
TOKEN_DE_HOST_PRUEBA=cambiar-en-local-no-usar-en-prod

# Backend de escritura (R3)
BACKEND_ESCRITURA_PORT=18091
BACKEND_ESCRITURA_URL=http://127.0.0.1:18091

# JWT de lectura (R3/R5). Rutas relativas a esta carpeta.
SYNC_JWT_PRIVATE_KEY_PATH=./keys/local-dev.pem
SYNC_JWT_KID=harukoia-pdc-local-1
SYNC_JWT_AUDIENCE=powersync-dev

# SQLite del harness (nunca apps/host/data/sala.sqlite)
HOST_HARNESS_DB=./tmp/host-harness.db
