# Copia a .env. Credenciales solo de desarrollo local. No son secretos de producción.
# Postgres / PowerSync: estación en pruebas/replica-central/ (mismo compose de la PdC).

DATABASE_URL=postgresql://harukoia:harukoia@127.0.0.1:54339/harukoia
POWERSYNC_PUBLIC_URL=http://127.0.0.1:18090
BACKEND_ESCRITURA_PORT=18091

# Debe coincidir con la sala del host (log: "identidad de la sala …") y con TOKEN_DE_HOST del host.
SALA_DEL_HOST=
TOKEN_DE_HOST=cambiar-en-local-no-usar-en-prod

# JWT de lectura (D-R3). Ruta relativa al cwd de la app (apps/backend-escritura).
SYNC_JWT_PRIVATE_KEY_PATH=../../pruebas/replica-central/keys/local-dev.pem
SYNC_JWT_KID=harukoia-pdc-local-1
SYNC_JWT_AUDIENCE=powersync-dev
