# Copia a .env (o .env.local). No definas PORT: portless lo asigna.
# URL pública: https://web.harukoia.local.iokoia.dev/

# Orquestador por el que la web entra a las salas.
# Local:        wss://orquestador.harukoia.local.iokoia.dev
# Makino Hara:  wss://orquestador.harukoia.makinohara.sys.iokoia.com
VITE_ORQUESTADOR_URL=wss://orquestador.harukoia.local.iokoia.dev

# Host de esta máquina, al que "Volverme host" le pide la invitación.
VITE_HOST_URL=https://host.harukoia.local.iokoia.dev
