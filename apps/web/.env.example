# Copia a .env (o .env.local). No definas PORT: portless lo asigna.
# URL pública: https://web.harukoia.local.iokoia.dev/

# Orquestador por el que la web entra a las salas.
# Tiene que ser EL MISMO al que se registró el host de la sala, o la sala sale "cerrada".
#
# Compartido (Makino Hara): sirve entre máquinas y redes distintas. Es el valor por defecto.
VITE_ORQUESTADOR_URL=wss://orquestador.harukoia.makinohara.sys.iokoia.com
#
# Local: solo si el host y todos los participantes están en esta misma máquina.
# `orquestador.harukoia.local.iokoia.dev` existe en cada máquina por separado.
# VITE_ORQUESTADOR_URL=wss://orquestador.harukoia.local.iokoia.dev

# Host de esta máquina, al que "Volverme host" le pide la invitación.
VITE_HOST_URL=https://host.harukoia.local.iokoia.dev
