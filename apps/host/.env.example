# Copia a .env (o .env.local). No definas PORT: portless lo asigna.
# URL pública: https://<PORTLESS_NAME>.dev/ (ver .cursor/rules/pm2-app.mdc)

# Orquestador al que se registra este host. Obligatoria: sin ella el host no arranca.
# Tiene que ser EL MISMO que usa la web de cada participante, o nadie encuentra la sala.
#
# Compartido (Makino Hara): sirve entre máquinas y redes distintas. Es el valor por defecto.
ORQUESTADOR_URL=wss://orquestador.harukoia.makinohara.sys.iokoia.com
#
# Local: solo si TODOS los participantes están en esta misma máquina.
# `orquestador.harukoia.local.iokoia.dev` existe en cada máquina por separado:
# en otra laptop apunta al orquestador de esa laptop, no al tuyo.
# ORQUESTADOR_URL=wss://orquestador.harukoia.local.iokoia.dev

# SQLite del documento Yjs de la sala. Si no se define, el host usa
# data/sala.sqlite respecto a su directorio de trabajo (con PM2, apps/host).
# No es la réplica de PowerSync. El identificador y los tokens no van en este archivo.
# SALA_SQLITE=

# Cuenta del keyring donde vive la identidad de la sala (identificador y tokens).
# Si no se define, el host usa `identidad-de-sala` en el servicio `iokoia.harukoia`.
# Vacía, el host no arranca. Los tokens no van en el SQLite del documento.
# SALA_IDENTIDAD=

# Origen de la web de esta máquina. Habilita GET /invitacion para "Volverme host".
# Sin ella la ruta no existe (un host sin web local, como el de una sala global).
WEB_ORIGEN=https://web.harukoia.local.iokoia.dev
